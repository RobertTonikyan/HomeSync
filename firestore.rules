rules_version = '2';

// HomeSync security model
// -----------------------
// * Every request must be signed in (the app signs in anonymously).
// * A user can only touch data of a household they are a member of:
//   households/{householdId}.memberUids must contain their uid.
// * A device becomes a member by adding ONLY its own uid to memberUids.
//   Knowing the household ID is therefore the key to the household,
//   so the ID must be long and random (see .env.example).
// * Documents can't be moved to another household, and text/photo sizes are capped.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && householdId is string
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.get('memberUids', []);
    }

    // Optional string field, capped length
    function textOk(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // Generic rules for documents that carry a householdId field
    function canRead() {
      return isMember(resource.data.householdId);
    }
    function canCreate() {
      return isMember(request.resource.data.householdId);
    }
    function canUpdate() {
      return isMember(resource.data.householdId)
        && request.resource.data.householdId == resource.data.householdId;
    }

    // ---------- Households ----------
    match /households/{householdId} {
      allow read: if isMember(householdId);

      // First device creates the household with only itself as member.
      allow create: if signedIn()
        && request.resource.data.householdId == householdId
        && request.resource.data.memberUids == [request.auth.uid];

      allow update: if signedIn()
        && request.resource.data.householdId == householdId
        && (
          // Existing member edits names / budget; membership list unchanged.
          (
            request.auth.uid in resource.data.get('memberUids', [])
            && request.resource.data.get('memberUids', []) == resource.data.get('memberUids', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'monthlyBudget', 'householdId'])
            && (request.resource.data.get('monthlyBudget', null) == null || request.resource.data.monthlyBudget is number)
          )
          ||
          // New device joins: adds exactly its own uid and changes nothing else.
          (
            !(request.auth.uid in resource.data.get('memberUids', []))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.resource.data.memberUids.hasAll(resource.data.get('memberUids', []))
            && request.resource.data.memberUids.size() == resource.data.get('memberUids', []).size() + 1
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids.size() <= 20
          )
        );

      allow delete: if false;
    }

    // ---------- Household data ----------
    match /shopping_items/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate() && textOk('name', 200);
      allow update: if canUpdate() && textOk('name', 200);
    }

    match /chores/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate() && textOk('title', 200);
      allow update: if canUpdate() && textOk('title', 200);
    }

    // Chore history is append-only (delete is used by "undo").
    match /chore_logs/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate()
        && textOk('title', 200)
        && request.resource.data.points is number && request.resource.data.points <= 30
        && request.resource.data.bonus is number && request.resource.data.bonus <= 15;
      allow update: if false;
    }

    match /calendar_events/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate() && textOk('title', 200) && textOk('date', 100);
      allow update: if canUpdate() && textOk('title', 200) && textOk('date', 100);
    }

    match /custom_recipes/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate() && textOk('title', 200);
      allow update: if canUpdate() && textOk('title', 200);
    }

    match /date_ideas/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate() && textOk('title', 200) && textOk('note', 500);
      allow update: if canUpdate() && textOk('title', 200) && textOk('note', 500);
    }

    match /expenses/{id} {
      allow read, delete: if canRead();
      allow create: if canCreate()
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && textOk('store', 120) && textOk('note', 500);
      allow update: if canUpdate()
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && textOk('store', 120) && textOk('note', 500);
    }

    // Compressed receipt photos (base64), stored apart from expenses.
    match /receipt_photos/{id} {
      allow read: if canRead();
      allow delete: if resource == null || canRead();
      allow create, update: if isMember(request.resource.data.householdId)
        && (resource == null || resource.data.householdId == request.resource.data.householdId)
        && request.resource.data.data is string
        && request.resource.data.data.size() < 950000;
    }

    // One document per household, keyed by the household ID.
    match /meal_plans/{householdId} {
      allow read: if isMember(householdId);
      allow write: if isMember(householdId) && request.resource.data.householdId == householdId;
    }

    match /house_notes/{householdId} {
      allow read: if isMember(householdId);
      allow write: if isMember(householdId)
        && request.resource.data.householdId == householdId
        && textOk('content', 2000);
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
